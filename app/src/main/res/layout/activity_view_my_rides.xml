<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvRidesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Rides"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp" />

        <!-- Accepted Rides Section -->

        <TextView
            android:id="@+id/tvAcceptedRidesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accepted Rides"
            android:textSize="21sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <ListView
            android:id="@+id/acceptedRidesListView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:dividerHeight="12dp"
            android:nestedScrollingEnabled="false"
            android:scrollbars="none"
            android:padding="4dp" />

        <!-- Unaccepted Rides Section -->

        <TextView
            android:id="@+id/tvUnacceptedRidesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unaccepted Rides"
            android:textSize="21sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:layout_marginTop="20dp" />

        <ListView
            android:id="@+id/unacceptedRidesListView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:dividerHeight="12dp"
            android:nestedScrollingEnabled="false"
            android:scrollbars="none"
            android:padding="4dp" />

    </LinearLayout>

</ScrollView>
